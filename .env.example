# Required: replace with your Discord bot token in your local .env file.
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# Optional for local runs: absolute path to the FFmpeg executable.
# Leave this variable unset when FFmpeg is available on PATH; do not set it empty.
# FFMPEG_PATH="C:/path/to/ffmpeg/bin/ffmpeg.exe"

# Docker Compose sets FFMPEG_PATH=/usr/bin/ffmpeg automatically.
